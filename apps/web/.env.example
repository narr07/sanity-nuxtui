# Find your project ID at https://www.sanity.io/manage
NUXT_SANITY_PROJECT_ID=your-project-id
NUXT_SANITY_DATASET=production

# Public URL of the site, used for the sitemap, canonical URLs, OG images and schema.org
NUXT_SITE_URL=http://localhost:3000
NUXT_SITE_NAME=Sanity × Nuxt UI

# Required in production: signs generated OG image URLs.
# Generate one with: openssl rand -base64 32
NUXT_APP_SECRET=

# Seconds before a cached page is refreshed in the background (ISR on Vercel,
# stale-while-revalidate elsewhere). 0 turns caching off. Default: 60
NUXT_CACHE_TTL=60

# Optional: enables Visual Editing / the Presentation tool. Deployments with a
# token are never cached, so use a separate deployment for previews.
# Create a token with the "Viewer" role at https://www.sanity.io/manage → API → Tokens
NUXT_SANITY_API_READ_TOKEN=
NUXT_SANITY_STUDIO_URL=http://localhost:3333
