# Find your project ID at https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Frontend URL opened by the Presentation tool (Visual Editing). `sanity dev`
# reads this file; `npm run deploy:studio` also reads .env.production, so put the
# deployed site URL there for the hosted Studio.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Sanity-hosted studio. Leave empty for the first `npm run deploy:studio`, then paste
# the app ID it prints so later deploys update the same studio.
SANITY_STUDIO_APP_ID=
